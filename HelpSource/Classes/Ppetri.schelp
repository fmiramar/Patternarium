SUBSECTION:: Competing enabled transitions
code::
Pseed(Pseq([42]), Ppetri((fuel: 12), (rare: (consume: (fuel: 1), weight: 1), common: (consume: (fuel: 1), weight: 4)), 12)).asStream.all;
::

