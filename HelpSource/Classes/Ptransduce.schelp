SUBSECTION:: Protocol state machine
code::
Ptransduce(Pseq([\open, 1, 2, \close, 3]), false, { |s, x|
    case
    { x == \open } { (state: true) }
    { x == \close } { (state: false) }
    { true } { (state: s, emit: if(s) { [x] } { [] }) }
}).asStream.all;
::

Pitch follows the output; repeated phrases make the structure audible. Uses the instruments in link::Guides/Patternarium#Example instruments::.
code::
(
// Sound companion: Ptransduce / Protocol state machine
var values = {
Ptransduce(Pseq([\open, 1, 2, \close, 3]), false, { |s, x|
    case
    { x == \open } { (state: true) }
    { x == \close } { (state: false) }
    { true } { (state: s, emit: if(s) { [x] } { [] }) }
}).asStream.all;
}.value;
values = if(values.isArray) { values } { [values] };
Pseq(values, 4).keep(64).collect { |x|
    (instrument: \mallet, degree: x*3, dur: 0.16, amp: 0.09)
}.play;
)
::
